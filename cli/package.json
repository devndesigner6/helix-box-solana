{
  "name": "helixbox-cli",
  "version": "0.2.0",
  "description": "Pair a laptop workspace with HelixBox on Android, with bounded model tools for Codex and Claude Code.",
  "homepage": "https://helixboxide.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devndesigner6/helix-box-solana.git",
    "directory": "cli"
  },
  "author": [
    {
      "name": "Soham Bharambe",
      "email": "soham@helixbox.xyz"
    },
    {
      "name": "Rinkit Adhana",
      "email": "rinkit@helixbox.xyz"
    }
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "helixbox-cli": "dist/index.js"
  },
  "files": [
    "dist",
    "bin",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc && npm run prepare-bin",
    "dev": "tsc && node dist/index.js",
    "prepare-bin": "node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@opencode-ai/sdk": "1.3.15",
    "ignore": "^6.0.2",
    "libsodium-wrappers": "^0.7.15",
    "qrcode-terminal": "^0.12.0",
    "shelljs": "^0.10.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/minimatch": "^5.1.2",
    "@types/node": "^20.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/shelljs": "^0.10.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
