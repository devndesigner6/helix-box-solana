# Helix Box App Environment Variables
# Copy to .env or set in EAS Build environment settings

EXPO_PUBLIC_GATEWAY_URL=wss://helixbox-proxy.onrender.com
EXPO_PUBLIC_MANAGER_URL=https://helixbox-manager.onrender.com
EXPO_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Leave unset to disable OTA updates. Never reuse the previous payment release's stream.
# EXPO_PUBLIC_UPDATE_SERVER_URL=https://your-solana-update-server/hot-updater
